#include <FastLED.h>
#define LED_PIN    2
#define NUM_LEDS    8

CRGB leds[NUM_LEDS];

void setup() {
  // put your setup code here, to run once:
FastLED.addLeds<WS2812, LED_PIN, GRB>(leds,NUM_LEDS);
}

void loop() {
  // Feu rouge:
leds[7] = CRGB(255, 0, 0); //Led située tout en haut du feu
leds[6] = CRGB(255, 0, 0);
leds[5] = CRGB(255, 0, 0);

leds[4] = CRGB(0, 0, 0);
leds[3] = CRGB(0, 0, 0);

leds[2] = CRGB(0, 0, 0);
leds[1] = CRGB(0, 0, 0);
leds[0] = CRGB(0, 0, 0);

FastLED.show();
delay(5000);


//Feu vert:
leds[7] = CRGB(0, 0, 0);
leds[6] = CRGB(0, 0, 0);
leds[5] = CRGB(0, 0, 0);

leds[4] = CRGB(0, 0, 0);
leds[3] = CRGB(0, 0, 0);

leds[2] = CRGB(0, 0, 0);
leds[1] = CRGB(0, 255, 0);
leds[0] = CRGB(0, 255, 0);

FastLED.show();
delay(5000);

//Feu Orange:

leds[7] = CRGB(0, 0, 0);
leds[6] = CRGB(0, 0, 0);
leds[5] = CRGB(0, 0, 0);

leds[4] = CRGB(255, 110, 0);
leds[3] = CRGB(255, 110, 0);

leds[2] = CRGB(0, 0, 0);
leds[1] = CRGB(0, 0, 0);
leds[0] = CRGB(0, 0, 0);

FastLED.show();
delay(2000);

}
